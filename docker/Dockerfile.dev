FROM nvidia/cuda:13.3.0-cudnn-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang-format \
    clang-tidy \
    cmake \
    doxygen \
    git \
    golang-go \
    graphviz \
    jq \
    libbenchmark-dev \
    libgtest-dev \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
 && rm -rf /var/lib/apt/lists/*

RUN go install github.com/rhysd/actionlint/cmd/actionlint@v1.6.26 && \
    cp /root/go/bin/actionlint /usr/local/bin/

COPY docs/requirements.txt /tmp/feature-elm-docs-requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/feature-elm-docs-requirements.txt \
    && rm -f /tmp/feature-elm-docs-requirements.txt

COPY docker/dev_entrypoint.sh /usr/local/bin/feature-elm-dev-entrypoint
RUN chmod +x /usr/local/bin/feature-elm-dev-entrypoint

WORKDIR /workspace

COPY . /workspace

# Ensure scripts are executable
RUN chmod +x /workspace/scripts/*.sh 2>/dev/null || true

ENTRYPOINT ["/usr/local/bin/feature-elm-dev-entrypoint"]
CMD ["bash"]
