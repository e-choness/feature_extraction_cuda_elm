FROM nvidia/cuda:13.3.0-cudnn-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang-format \
    clang-tidy \
    cmake \
    curl \
    doxygen \
    git \
    graphviz \
    jq \
    libbenchmark-dev \
    libgtest-dev \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
 && rm -rf /var/lib/apt/lists/*

RUN ACTIONLINT_VERSION=$(curl -sSfL https://api.github.com/repos/rhysd/actionlint/releases/latest | jq -r '.tag_name' | tr -d 'v') && \
    curl -sSfL https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint-linux-amd64 -o /usr/local/bin/actionlint && \
    chmod +x /usr/local/bin/actionlint

COPY docs/requirements.txt /tmp/feature-elm-docs-requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/feature-elm-docs-requirements.txt \
    && rm -f /tmp/feature-elm-docs-requirements.txt

COPY docker/dev_entrypoint.sh /usr/local/bin/feature-elm-dev-entrypoint
RUN chmod +x /usr/local/bin/feature-elm-dev-entrypoint

WORKDIR /workspace

COPY . /workspace

ENTRYPOINT ["/usr/local/bin/feature-elm-dev-entrypoint"]
CMD ["bash"]
