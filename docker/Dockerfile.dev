# CUDA minor/major upgrades are manual: Dependabot only proposes patch bumps (.github/dependabot.yml).
FROM nvidia/cuda:13.4.1-devel-ubuntu24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG ACTIONLINT_VERSION=1.7.12
ARG ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang-format \
    clang-tidy \
    cmake \
    curl \
    git \
    jq \
    libbenchmark-dev \
    libgtest-dev \
    ninja-build \
    pkg-config \
    python3 \
 && rm -rf /var/lib/apt/lists/*

# actionlint: pinned release binary with checksum verification (no Go toolchain needed)
RUN curl -fsSLo /tmp/actionlint.tar.gz \
      "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz" \
 && echo "${ACTIONLINT_SHA256}  /tmp/actionlint.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/actionlint.tar.gz -C /usr/local/bin actionlint \
 && rm -f /tmp/actionlint.tar.gz

COPY docker/dev_entrypoint.sh /usr/local/bin/feature-elm-dev-entrypoint
RUN chmod +x /usr/local/bin/feature-elm-dev-entrypoint

WORKDIR /workspace

COPY . /workspace

# Ensure scripts are executable
RUN chmod +x /workspace/scripts/*.sh 2>/dev/null || true

ENTRYPOINT ["/usr/local/bin/feature-elm-dev-entrypoint"]
CMD ["bash"]
