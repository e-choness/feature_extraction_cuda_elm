# CPU-only demo image. Runs on any x86-64 host and on the free "CPU basic" Hugging Face Spaces tier.
FROM ubuntu:24.10 AS build

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    ninja-build \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY CMakeLists.txt ./
COPY src ./src

RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DENABLE_CUDA=OFF -DBUILD_TESTING=OFF \
 && cmake --build build --target demo_app \
 && strip build/src/app/demo_app

FROM ubuntu:24.10

# libgomp: the OpenMP runtime for the multithreaded CPU paths.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*

# UID 1000 (the image's built-in "ubuntu" user) is what Hugging Face Spaces runs containers as.
WORKDIR /app
COPY --from=build --chown=1000:1000 /src/build/src/app/demo_app /app/demo_app
COPY --chown=1000:1000 demo/ui /app/ui
COPY --chown=1000:1000 data/datasets/digits_8x8.csv /app/data/digits_8x8.csv
COPY --chown=1000:1000 data/benchmarks/latest /app/benchmarks
USER 1000:1000

ENV DEMO_USE_GPU=0 \
    DEMO_PORT=7860 \
    DEMO_STATIC_PATH=/app/ui \
    DEMO_BENCHMARK_PATH=/app/benchmarks \
    DEMO_DATASET_PATH=/app/data/digits_8x8.csv \
    DEMO_MAX_HIDDEN=1024

EXPOSE 7860
CMD ["/app/demo_app"]
